# ============================================================
# WhatsApp Worker — required environment variables
# Copy to .env (never commit the real .env)
# ============================================================

# Supabase — same project as the CRM.
# Use the SERVICE ROLE key; the worker bypasses RLS to write
# session state and heartbeats. Keep this secret and server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AES-256-GCM key for encrypting Baileys session state at rest.
# MUST be different from the CRM's ENCRYPTION_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=your-64-char-hex-key-here

# Stable identity for this worker instance. Used for connection
# locking and outbox job ownership. Must be unique per running
# worker if you ever run more than one (for different accounts).
# Generate: node -e "console.log(require('crypto').randomUUID())"
WHATSAPP_WORKER_ID=your-worker-uuid-here

# UUID of the whatsapp_accounts row this worker manages.
# Created once via the CRM admin API (Phase 3). Paste the id here.
WHATSAPP_ACCOUNT_ID=your-whatsapp-account-uuid

# Outbox poll interval in milliseconds. Default: 2000.
# OUTBOX_POLL_INTERVAL_MS=2000

# Heartbeat interval in milliseconds. Default: 30000.
# HEARTBEAT_INTERVAL_MS=30000

# Log level: debug | info | warn | error. Default: info.
# LOG_LEVEL=info
